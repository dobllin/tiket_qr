# Salin file ini menjadi .env lalu isi sesuai acara

# Info acara (tampil di halaman pendaftaran & tiket)
EVENT_NAME="Dentist Art Week"
EVENT_DATE="Sabtu, 14 November 2026 · 19.00 WIB"
EVENT_PLACE="Auditorium Utama, Jakarta"
QUOTA=300

# Info pembayaran yang tampil di form. Kalau diisi, peserta WAJIB upload gambar bukti transfer,
# dan panitia bisa melihat gambarnya di dashboard (tombol "Lihat bukti").
# Kosongkan (PAYMENT_INFO="") kalau acaranya gratis. Pakai \n untuk ganti baris.
PAYMENT_INFO="Transfer Rp50.000 ke BCA 1234567890 a.n. Panitia Dentist Art Week\nKonfirmasi: 0812-xxxx-xxxx"

# Akun panitia (admin & petugas scanner), pisahkan dengan koma
ADMIN_ACCOUNTS="admin:ganti-password-ini,petugas1:password-petugas1,petugas2:password-petugas2"

# Kunci rahasia untuk tanda tangan tiket & login. WAJIB diganti, minimal 24 karakter.
# Bikin yang acak dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JANGAN diganti setelah pendaftaran dibuka, karena semua tiket lama jadi tidak valid.
SECRET="ganti-dengan-kunci-acak-yang-panjang-sekali"

# Zona waktu untuk jam daftar & jam masuk
TIMEZONE=Asia/Jakarta

PORT=3000
# Isi "production" kalau sudah online pakai https
NODE_ENV=development

# Hanya untuk online di Vercel: database Turso (lihat README). Kosongkan kalau jalan di komputer sendiri / VPS.
# TURSO_DATABASE_URL="libsql://tiket-namakamu.turso.io"
# TURSO_AUTH_TOKEN="token-dari-turso"
